# Copy this file to .env.research in the repository root. Never commit the copy.
# Use a MongoDB Atlas cluster/database dedicated to this research project, never
# the application production database (forbidden name: viettalk).

# Required: use a MongoDB URI for the isolated research cluster.
RESEARCH_MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority

# Required: name must be distinct from production; "viettalk_research" is the
# verifier's documented default.
RESEARCH_MONGO_DB=viettalk_research

# Required: generate locally with a cryptographically secure generator, e.g.
# `openssl rand -hex 32`. Do not reuse an application/JWT secret.
RESEARCH_SALT=<64-or-more-hex-characters>

# Optional. Provide both values or neither; leave commented until the queue is
# explicitly enabled for the research environment.
# UPSTASH_REDIS_REST_URL=https://<instance>.upstash.io
# UPSTASH_REDIS_REST_TOKEN=<token>

