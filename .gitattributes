# Normalize line endings: store LF in the repo, check out native on Windows.
* text=auto

# Scripts that must keep a specific ending regardless of platform
*.sh   text eol=lf
*.bash text eol=lf
*.ps1  text eol=crlf
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Explicit text types
*.ts    text
*.tsx   text
*.js    text
*.jsx   text
*.mjs   text
*.cjs   text
*.json  text
*.md    text
*.css   text
*.scss  text
*.html  text
*.yml   text
*.yaml  text
*.py    text
*.txt   text
*.env*  text

# Binary — never touch
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.svg  text
*.pdf  binary
*.docx binary
*.xlsx binary
*.pptx binary
*.zip  binary
*.gz   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
*.mp3  binary
*.mp4  binary
*.wav  binary
*.webm binary
